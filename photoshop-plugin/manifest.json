{
  "manifestVersion": 5,
  "id": "com.studiodmtl.utiliscope.ps",
  "name": "UtiliScope",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "utiliscopePanel",
      "label": {
        "default": "UtiliScope",
        "fr": "UtiliScope"
      },
      "minimumSize": { "width": 320, "height": 480 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 720 },
      "preferredFloatingSize": { "width": 360, "height": 720 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "light", "lightest"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "light", "lightest"],
      "species": ["generic"]
    }
  ],
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "request",
    "launchProcess": { "schemes": ["https"] }
  }
}
